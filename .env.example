# Telegram
TELEGRAM_TOKEN=your_telegram_bot_token_here

# PostgreSQL
POSTGRES_USER=caterpillar
POSTGRES_PASSWORD=caterpillar_pass
POSTGRES_DB=caterpillaread
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Redis
REDIS_URL=redis://redis:6379/0

# Настройки текста
CHUNK_SIZE_MIN=500
CHUNK_SIZE_MAX=3000
MAX_FILE_SIZE=52428800

# Папка загрузок
UPLOAD_DIR=uploads

# Логирование
LOG_LEVEL=INFO
